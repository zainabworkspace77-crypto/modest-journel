# ---------- Public site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Firebase WEB app config (Project settings > General > Your apps > Web app) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase ADMIN SDK (Project settings > Service accounts > Generate new private key) ----------
# Keep these SECRET. Never prefix with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value inside double quotes, keeping the \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Only used once by `npm run setup-db` to create your admin login ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
